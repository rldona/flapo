; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Flapo"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

GameConfig="*res://scripts/game_config.gd"

[display]

window/size/viewport_width=288
window/size/viewport_height=512
window/size/window_width_override=576
window/size/window_height_override=1024
window/stretch/mode="viewport"
window/stretch/scale_mode="integer"
window/handheld/orientation="portrait"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

textures/canvas_textures/default_texture_filter=0
rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"

[input]

flap={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"pressed":false,"physical_keycode":32,"script":null)
, Object(InputEventMouseButton,"device":-1,"pressed":false,"button_index":1,"script":null)
, Object(InputEventScreenTouch,"device":-1,"pressed":false,"index":0,"script":null)
]
}
restart={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"pressed":false,"physical_keycode":82,"script":null)
, Object(InputEventKey,"device":-1,"pressed":false,"physical_keycode":4194309,"script":null)
]
}
pause={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"pressed":false,"physical_keycode":4194305,"script":null)
, Object(InputEventKey,"device":-1,"pressed":false,"physical_keycode":80,"script":null)
]
}

[input_devices]

pointing/emulate_mouse_from_touch=true
