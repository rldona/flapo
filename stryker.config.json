{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vite.config.ts"
  },
  "mutate": [
    "src/config/GameConfig.ts",
    "src/core/Rng.ts",
    "src/core/types.ts",
    "src/core/Loop.ts",
    "src/core/Input.ts",
    "src/meta/SaveManager.ts",
    "src/meta/DailyChallenge.ts",
    "src/meta/GhostRecord.ts",
    "src/systems/Bird.ts",
    "src/systems/Fruit.ts",
    "src/systems/Effects.ts",
    "src/systems/Journey.ts",
    "src/systems/Wind.ts",
    "src/systems/Pipe.ts",
    "src/systems/PipeSpawner.ts",
    "src/systems/AirSpawner.ts",
    "src/systems/Ghost.ts",
    "src/systems/DeathLines.ts",
    "src/systems/Snapshot.ts",
    "src/systems/Juice.ts"
  ],
  "coverageAnalysis": "perTest",
  "ignorePatterns": [".trunk", "dist", "coverage", "test-results"],
  "reporters": ["clear-text", "progress", "html", "json"],
  "htmlReporter": {
    "fileName": "reports/mutation/mutation.html"
  },
  "jsonReporter": {
    "fileName": "reports/mutation/mutation.json"
  },
  "thresholds": {
    "high": 100,
    "low": 99,
    "break": 99
  },
  "timeoutMS": 20000,
  "concurrency": 6,
  "incremental": true,
  "incrementalFile": "reports/stryker-incremental.json",
  "tempDirName": ".stryker-tmp",
  "cleanTempDir": true
}
